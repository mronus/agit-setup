{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "sh \"@AGIT_HOOK@\" cursor session-start",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "sh \"@AGIT_HOOK@\" cursor session-end",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "sh \"@AGIT_HOOK@\" cursor pre-edit",
        "matcher": "^(Write|Delete)$",
        "timeout": 30
      },
      {
        "command": "sh \"@AGIT_HOOK@\" cursor pre-shell",
        "matcher": "^Shell$",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "sh \"@AGIT_HOOK@\" cursor post-edit",
        "matcher": "^(Write|Delete)$",
        "timeout": 30
      },
      {
        "command": "sh \"@AGIT_HOOK@\" cursor post-shell",
        "matcher": "^Shell$",
        "timeout": 30
      }
    ],
    "postToolUseFailure": [
      {
        "command": "sh \"@AGIT_HOOK@\" cursor post-edit",
        "matcher": "^(Write|Delete)$",
        "timeout": 30
      },
      {
        "command": "sh \"@AGIT_HOOK@\" cursor post-shell",
        "matcher": "^Shell$",
        "timeout": 30
      }
    ]
  }
}
